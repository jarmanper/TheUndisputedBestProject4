; Capture harness for the family photograph on the entrance bench.
; Companion to tools/entrance_views.tscn (which frames the whole group); these
; three VIEW__ markers all sit at player eye height, 1.6 m, on the lobby floor
; a player can actually stand on, and look at the photo the way someone who
; noticed the bears would.
; Run: tools/godot.sh --resolution 1280x720 --script res://tools/capture.gd -- res://tools/photo_views.tscn

[ext_resource type="PackedScene" path="res://scenes/environments/area_a_entrance.tscn" id="area"]
[ext_resource type="PackedScene" path="res://scenes/game/entrance_dressing.tscn" id="dress"]

