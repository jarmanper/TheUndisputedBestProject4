[node name="Intro" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 3)
monitorable = false
script = ExtResource("1_story")
trigger_id = "intro"
lines = Array[String](["Reyes: Main power's dead. Emergency lights only. Great.", "Dr. Hale: Reyes? You're inside. Good. This is Dr. Hale, I'm the one who called your company.", "Dr. Hale: The blackout sealed every door below the lobby. I need the generator back before the backup cells run dry.", "Dr. Hale: Security office, west side of the lobby. There's a keycard on the desk. Start there.", "Reyes: Anyone else down here with you, Doc?", "Dr. Hale: ...Just keep your footsteps quiet. Please."])
objective = "Find the security keycard (security office, west of the lobby)"
requires_flag = ""
sets_flag = ""

