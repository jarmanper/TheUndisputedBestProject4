[node name="SecurityOffice" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -12.15, 1.5, 1.5)
monitorable = false
script = ExtResource("1_story")
trigger_id = "security"
lines = Array[String](["Reyes: Keycard. Blood on the lanyard. Still wet.", "Recording: Security log, night of the blackout. Something's tapping in the vents. Two taps, pause. Two taps. Like a clock that can't make up its mind.", "Recording: Hale says don't radio it in. Hale says it can hear the radio.", "Dr. Hale: Ignore that. The generator room is on the lower levels, through containment. Go."])
objective = "Restore power at the generator (lower levels, through containment)"
requires_flag = ""
sets_flag = ""

