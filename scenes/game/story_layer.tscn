monitorable = false
script = ExtResource("1_story")
trigger_id = "clock_workshop"
lines = Array[String](["Recording: Dr. Hale, personal log. Subject B, Teo, expired at 3:17 this morning. Subject A has not stopped screaming.", "Recording: The twins were never two people. One heartbeat split across two bodies. Without Teo, Tomas is dying too.", "Recording: So I will give Teo a new heart. Brass. Springs. An escapement. I will wind him back.", "Reyes: Wind him back... Hale, what did you do in here?", "Dr. Hale: What anyone would do. I saved a child."])
objective = ""
