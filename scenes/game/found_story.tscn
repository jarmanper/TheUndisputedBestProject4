[gd_scene format=3]

; The story you find in the world: wordless props that put the submitted story
; where the player can see it (AGENTS.md section 4). Instanced at the origin of
; scenes/game/main.tscn, beside TimbukFacility, so these are world coordinates.
;
; Adds no text, no trigger, no interactable and no rule. Only the two gurneys
; collide (they are generated props with box collision), and they lie against
; the chamber's back wall, off the Twin's dais. tests/found_story.gd guards all
; of it.

[ext_resource type="PackedScene" path="res://scenes/game/story/recorder.tscn" id="1_rec"]
[ext_resource type="PackedScene" path="res://scenes/game/story/flashlight.tscn" id="2_torch"]
[ext_resource type="PackedScene" path="res://scenes/props/keycard.tscn" id="3_card"]
[ext_resource type="PackedScene" path="res://scenes/props/photo_frame.tscn" id="4_photo"]
[ext_resource type="PackedScene" path="res://scenes/props/covered_gurney.tscn" id="5_gurney"]
[ext_resource type="Script" path="res://scripts/visual/prop_retint.gd" id="6_retint"]
[ext_resource type="Material" path="res://assets/materials/photo_family.tres" id="7_family"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_pencil"]
albedo_color = Color(0.07, 0.07, 0.08, 1)
roughness = 0.95

[sub_resource type="BoxMesh" id="BoxMesh_mark"]
material = SubResource("StandardMaterial3D_pencil")
size = Vector3(0.004, 0.009, 0.13)

[node name="FoundStory" type="Node3D"]

; --- Mom's recordings ------------------------------------------------------
; Every "Mom:" line in story_layer.tscn is a tape she left for her child. A
; recorder sits in each room where one plays: its red light blinks until the
; line starts, then the play key drops and the reels turn. The voice becomes
; a thing the player finds, which is the Found theme, and the first one sits on
; the security desk straight ahead of the spawn, under the first line.
[node name="Recordings" type="Node3D" parent="."]

[node name="MomIntro" parent="Recordings" instance=ExtResource("1_rec")]
transform = Transform3D(1.2740865, 0, -0.2582701, 0, 1.3, 0, 0.2582701, 0, 1.2740865, 0.3, 1.145, -0.74)
trigger_id = "intro"
play_time = 8.0

[node name="MomWorkshop" parent="Recordings" instance=ExtResource("1_rec")]
transform = Transform3D(1.2595861, 0, -0.32162514, 0, 1.3, 0, 0.32162514, 0, 1.2595861, 8.55, 0.925, -25.38)
trigger_id = "clock_workshop"

[node name="MomContainment" parent="Recordings" instance=ExtResource("1_rec")]
transform = Transform3D(1.2380337, 0, -0.3965762, 0, 1.3, 0, 0.3965762, 0, 1.2380337, 3.6, 0.875, -35.15)
trigger_id = "containment"
play_time = 5.0

[node name="MomGenerator" parent="Recordings" instance=ExtResource("1_rec")]
