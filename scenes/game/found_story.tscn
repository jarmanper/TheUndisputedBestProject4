trigger_id = "generator"
play_time = 5.0

; --- Dad went down to him ---------------------------------------------------
; "Your father went down to him." Halfway down the lower stairs his flashlight
; lies where he dropped it, still on, its beam pointing the way he went. His
; keycard is two steps above it.
[node name="DadsTrail" type="Node3D" parent="."]

