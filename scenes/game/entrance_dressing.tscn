[gd_scene load_steps=7 format=3]

; Wordless story dressing for the opening area (Area A entrance).
;
; PREMISE-NEUTRAL as it stands. Everything here is true of both the submitted
; story doc and the dialogue actually shipped in scenes/game/story_layer.tscn:
; two identical children belonged to this building, and clocks matter here.
; It says nothing about who the player is or whose children they were, so it
; does not contradict Hale / Reyes / Tomas / Teo.
;
; Composes existing props from scenes/props/ only. Adds no text, no mechanics,
; no interactables, no pickups, no gameplay numbers.
;
; Instanced at the origin alongside TimbukFacility, which places
; AreaAEntrance at the origin too, so these are world coordinates.

[ext_resource type="PackedScene" path="res://scenes/props/locker_row.tscn" id="locker"]
[ext_resource type="PackedScene" path="res://scenes/props/teddy_bear.tscn" id="teddy"]
[ext_resource type="PackedScene" path="res://scenes/props/grandfather_clock.tscn" id="clock"]
[ext_resource type="PackedScene" path="res://scenes/props/photo_frame.tscn" id="photo"]
[ext_resource type="Script" path="res://scripts/visual/prop_retint.gd" id="retint"]
[ext_resource type="Material" path="res://assets/materials/photo_family.tres" id="photo_family_mat"]

[node name="EntranceDressing" type="Node3D"]

; --- Staff lockers -------------------------------------------------------
; Two flush locker rows on the lobby back wall, west of the security gate.
; Ordinary staff furniture: it reads as "people worked here", and its built-in
; bench is what the two bears sit on. Flush against the wall, clear of the
; route to the gate, so it blocks nothing and changes no navigation.
[node name="StaffLockers" type="Node3D" parent="."]

[node name="LockerLeft" parent="StaffLockers" instance=ExtResource("locker")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6, 0, -5.5)

[node name="LockerRight" parent="StaffLockers" instance=ExtResource("locker")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -4.4, 0, -5.5)

; --- The two children ----------------------------------------------------
; Two identical bears sitting side by side on the bench. Identical, not
; merely two: the pairing is the whole message. A research facility lobby is
; the wrong place for them, which is what makes a player stop and look.
; True of either story version, since both have twin boys who lived here.
[node name="BearLeft" parent="StaffLockers" instance=ExtResource("teddy")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5.44, 0.47, -4.9)

[node name="BearRight" parent="StaffLockers" instance=ExtResource("teddy")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5.1, 0.47, -4.9)

; --- Whose children they were ---------------------------------------------
; A desk photograph standing on the same bench, beside the two bears: two
; adults and two identical boys. The bears say "two children lived here";
; the photograph says who they belonged to, and that there were two of them,
; without a word. It sits in the same warm pool of light, turned about 29
; degrees toward the walking route so a player coming from the security desk
; sees its face rather than its edge. Scaled 1.5 (0.30 x 0.38 m, a big desk
; portrait) because at the prop's authored 0.20 m it was 22 pixels wide from
; the bench marker and the four figures could not be made out. Scenery only:
; no collision (the prop is built collide=False), no interact prompt, no
; pickup -- testers already pressed E on scenery and got nothing.
;
; THIS frame is the only one in the game that shows the family. The prop
; itself ships with an anonymous two-colleague print (photo_staff), because
; build_facility stands the same frame on seven desks across the facility and
; the player's own family cannot be sitting on all of them. prop_retint swaps
; surface 1 -- the print; surface 0 is the wooden frame and stand -- on this
; instance only, without touching the generated prop scene.
[node name="FamilyPhoto" parent="StaffLockers" instance=ExtResource("photo")]
transform = Transform3D(1.31637, 0, 0.719145, 0, 1.5, 0, -0.719145, 0, 1.31637, -4.78, 0.47, -4.89)
script = ExtResource("retint")
surfaces = PackedInt32Array(1)
material = ExtResource("photo_family_mat")

; --- The clock motif -----------------------------------------------------
; A domestic heirloom clock standing in a corporate lobby: an anomaly, a tall
; silhouette that carries the group from across the room, and an audible pull
; (the prop autoplays clock_tick_loop). Plants the motif that pays off at the
; clock workshop and the Twin.
[node name="GrandfatherClock" parent="." instance=ExtResource("clock")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.7, 0, -5.5)

; --- Staging -------------------------------------------------------------
; The lobby is lit cool blue-white throughout. This group is the only warm
; pool of light in the room, so the eye goes to it from the spawn point
; without anything having to tell the player to look.
[node name="Lights" type="Node3D" parent="."]

[node name="bench_key" type="SpotLight3D" parent="Lights"]
transform = Transform3D(1, 0, 0, 0, 0.42261827, 0.9063078, 0, -0.9063078, 0.42261827, -5.2, 3.1, -3.9)
light_color = Color(1, 0.8, 0.55, 1)
light_energy = 7.0
light_volumetric_fog_energy = 2.5
shadow_enabled = true
shadow_blur = 1.5
spot_range = 7.0
spot_attenuation = 0.9
spot_angle = 38.0
spot_angle_attenuation = 1.2

