light_color = Color(1, 0.86, 0.68, 1)
light_energy = 2.4
light_volumetric_fog_energy = 1.5
omni_range = 3.4
omni_attenuation = 1.4

[node name="clock_face" type="OmniLight3D" parent="Lights"]
