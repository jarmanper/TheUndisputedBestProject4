; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="project4"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game/game_state.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720


[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}

move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}

move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}

mark={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}

suspend={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

explode={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[layer_names]

3d_physics/layer_1="Level geometry"
3d_physics/layer_2="Player"
3d_physics/layer_3="Targets"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
